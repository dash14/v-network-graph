{
  "name": "v-network-graph",
  "description": "An interactive network graph visualization component for Vue 3",
  "version": "0.10.0-beta.0",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "homepage": "https://dash14.github.io/v-network-graph/",
  "repository": {
    "type": "git",
    "url": "https://github.com/dash14/v-network-graph.git"
  },
  "files": [
    "lib"
  ],
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "oxlint --fix && eslint --fix \"**/*.vue\"",
    "lint:check": "oxlint && eslint \"**/*.vue\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "pnpm run clean && pnpm run build:tc && pnpm run build:lib",
    "build:tc": "vue-tsc --noEmit",
    "build:lib": "vite build",
    "clean": "rimraf lib",
    "prepare": "lefthook install",
    "test": "vitest run"
  },
  "dependencies": {
    "@dash14/svg-pan-zoom": "^3.6.9",
    "lodash-es": "^4.18.1",
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.1",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^5.0.3",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/language-core": "^3.3.12",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.86.0",
    "eslint-plugin-vue": "^10.11.1",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "~1.86.0",
    "playwright": "^1.63.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.105.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-browser-vue": "^3.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "d3-force": "^3.0.0",
    "vue": "^3.5.13"
  },
  "peerDependenciesMeta": {
    "d3-force": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "style": "./lib/style.css",
      "default": "./lib/index.js"
    },
    "./lib/force-layout": "./lib/force-layout.js",
    "./lib/*": "./lib/*"
  }
}
